{
    "name": "@RaffaeleCanale/starter",
    "version": "3.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RaffaeleCanale/wx-ts-library.git"
    },
    "files": [
        "dist",
        "tsconfig"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tsconfig/web": "./tsconfig/tsconfig.web.json",
        "./tsconfig/node": "./tsconfig/tsconfig.node.json",
        "./tsconfig/lib-web": "./tsconfig/tsconfig.lib-web.json",
        "./tsconfig/lib-node": "./tsconfig/tsconfig.lib-node.json"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "tsc -b",
        "test": "vitest run --passWithNoTests"
    },
    "devDependencies": {
        "@types/node": "^22.20.2",
        "typescript": "^7.0.2",
        "vite-plus": "^0.3.1",
        "vitest": "^5.0.0"
    },
    "peerDependencies": {
        "vite-plus": ">=0.1.0"
    },
    "peerDependenciesMeta": {
        "vite-plus": {
            "optional": true
        }
    }
}
